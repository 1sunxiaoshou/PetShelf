{
  "name": "petshelf",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:fullstack": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "import:demo": "node scripts/import-demo-pets.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev:frontend": "vite --host 127.0.0.1",
    "dev:backend": "node server.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@neondatabase/neon-js": "^0.6.1-beta",
    "@vitejs/plugin-react": "^5.0.4",
    "adm-zip": "^0.5.17",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^0.545.0",
    "multer": "^2.1.1",
    "pg": "^8.21.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.10"
  }
}
